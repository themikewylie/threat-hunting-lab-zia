   "source": [
    "#  Creates a dynamic dashboard for exploring and filtering ZIA log data interactively, enabling threat hunters to pivot on columns, filter by time/search, and visualize distributions and details without manual coding. The interface updates reactively as filters change.\n",
    "import ipywidgets as widgets\n",
    "from IPython.display import display, clear_output\n",
    "import plotly.express as px\n",
    "import pandas as pd\n",
    "import requests\n",
    "import json\n",
    "\n",
    "LA_TZ = \"America/Los_Angeles\"\n",
    "\n",
    "# ---------- Controls ----------\n",
    "pivot_dropdown = widgets.Dropdown(\n",
    "    options=sorted(df.columns),\n",
    "    value=\"Hostname\" if \"Hostname\" in df.columns else df.columns[0],\n",
    "    description=\"Pivot:\",\n",
    "    layout=widgets.Layout(width=\"500px\")\n",
    ")\n",
    "\n",
    "top_n_slider = widgets.IntSlider(\n",
    "    value=30, min=5, max=200, step=5,\n",
    "    description=\"Top N:\",\n",
    "    continuous_update=False\n",
    ")\n",
    "\n",
    "start_picker = widgets.DatetimePicker(description=\"Start (LA)\")\n",
    "end_picker   = widgets.DatetimePicker(description=\"End (LA)\")\n",
    "\n",
    "search_box = widgets.Text(\n",
    "    description=\"Search:\",\n",
    "    placeholder=\"e.g. github, /dns-query, POST, user@acme.com\",\n",
    "    layout=widgets.Layout(width=\"700px\")\n",
    ")\n",
    "\n",
    "search_cols = widgets.SelectMultiple(\n",
    "    options=[\"(all columns)\", \"URL\", \"Hostname\", \"User\", \"User Agent\", \"Request Method\", \"Policy Action\",\n",
    "             \"Client IP\", \"Client External IP\", \"Server IP\", \"Referrer URL\", \"Download File Type\",\n",
    "             \"Download File Name\", \"URL Category\", \"Threat Name\"],\n",
    "    value=(\"Hostname\", \"URL\"),   # default search scope\n",
    "    description=\"Search in:\",\n",
    "    layout=widgets.Layout(width=\"700px\", height=\"160px\")\n",
    ")\n",
    "\n",
    "apply_btn = widgets.Button(description=\"Apply Filters\", button_style=\"primary\")\n",
    "reset_btn = widgets.Button(description=\"Reset\", button_style=\"warning\")\n",
    "\n",
    "# ---------- AI Enrichment Controls ----------\n",
    "ai_provider_dropdown = widgets.Dropdown(\n",
    "    options=[\"Google AI Studio (Gemini)\", \"OpenAI\", \"Anthropic (Claude)\"],\n",
    "    value=\"Google AI Studio (Gemini)\",\n",
    "    description=\"AI Provider:\",\n",
    "    layout=widgets.Layout(width=\"350px\")\n",
    ")\n",
    "\n",
    "ai_key_input = widgets.Password(\n",
    "    description=\"API Key:\",\n",
    "    placeholder=\"Paste Selected Provider API Key\",\n",
    "    layout=widgets.Layout(width=\"400px\")\n",
    ")\n",
    "\n",
    "ai_prompt_text = widgets.Textarea(\n",
    "    value=(\"You are an expert Cyber Threat Hunter. Analyze the following ZIA web proxy log slice for evidence of \"\n",
    "           \"malicious behavior, advanced persistent threat (APT) activity, data exfiltration, C2 beaconing, or compliance violations. \"\n",
    "           \"Identify suspicious rows, provide a short risk assessment, and suggest mitigation strategies.\"),\n",
    "    description=\"System Prompt:\",\n",
    "    layout=widgets.Layout(width=\"750px\", height=\"120px\")\n",
    ")\n",
    "\n",
    "ai_sanitize_toggle = widgets.Checkbox(\n",
    "    value=True,\n",
    "    description=\"Sanitize Data (Mask IPs and User Fields)\"\n",
    ")\n",
    "\n",
    "ai_row_limit = widgets.IntSlider(\n",
    "    value=15, min=5, max=50, step=5,\n",
    "    description=\"Rows to Send:\",\n",
    "    continuous_update=False\n",
    ")\n",
    "\n",
    "ai_analyze_btn = widgets.Button(\n",
    "    description=\"Run AI Analysis\",\n",
    "    button_style=\"success\",\n",
    "    icon=\"magic\"\n",
    ")\n",
    "\n",
    "# ---------- Outputs ----------\n",
    "pivot_output = widgets.Output()\n",
    "tail_output  = widgets.Output()\n",
    "table_output = widgets.Output()\n",
    "status_out   = widgets.Output()\n",
    "ai_output_area = widgets.Output()\n",
    "\n",
    "# ---------- Helpers ----------\n",
    "def _ensure_la(ts):\n",
    "    \"\"\"Coerce a python datetime or pandas Timestamp to tz-aware LA Timestamp.\"\"\"\n",
    "    if ts is None:\n",
    "        return None\n",
    "    t = pd.Timestamp(ts)\n",
    "    if t.tzinfo is None:\n",
    "        return t.tz_localize(LA_TZ)\n",
    "    return t.tz_convert(LA_TZ)\n",
    "\n",
    "def filtered_df():\n",
    "    d = df\n",
    "\n",
    "    # Time filter (Logged Time Parsed)\n",
    "    start = _ensure_la(start_picker.value)\n",
    "    end   = _ensure_la(end_picker.value)\n",
    "\n",
    "    if start is not None and end is not None:\n",
    "        # auto-swap if user picks start > end\n",
    "        if start > end:\n",
    "            start, end = end, start\n",
    "        d = d[(d[\"Logged Time Parsed\"] >= start) & (d[\"Logged Time Parsed\"] <= end)]\n",
    "\n",
    "    # Search filter\n",
    "    q = (search_box.value or \"\").strip()\n",
    "    if q:\n",
    "        cols = list(search_cols.value)\n",
    "        if \"(all columns)\" in cols:\n",
    "            cols = list(d.columns)\n",
    "\n",
    "        mask = pd.Series(False, index=d.index)\n",
    "        for c in cols:\n",
    "            if c in d.columns:\n",
    "                mask = mask | d[c].astype(\"string\").fillna(\"\").str.contains(q, case=False, regex=False)\n",
    "        d = d[mask]\n",
    "\n",
    "    return d\n",
    "\n",
    "def pivot_count_df(dataframe, column):\n",
    "    return (\n",
    "        dataframe[column]\n",
    "        .astype(\"string\").fillna(\"NaN\")\n",
    "        .value_counts()\n",
    "        .rename_axis(column)\n",
    "        .reset_index(name=\"Count\")\n",
    "    )\n",
    "\n",
    "# ---- Filtered table columns (requested) ----\n",
    "TABLE_COLS = [\n",
    "    \"Event Time\",\n",
    "    \"User\",\n",
    "    \"URL\",\n",
    "    \"URL Category\",\n",
    "    \"Policy Action\",\n",
    "    \"Application Status\",   # will be shown as \"Status\"\n",
    "    \"User Agent\",\n",
    "    \"Client IP\",\n",
    "    \"Client External IP\",\n",
    "    \"Server IP\",\n",
    "    \"Request Method\",\n",
    "    \"Referrer URL\",\n",
    "    \"Download File Type\",\n",
    "    \"Download File Name\",\n",
    "]\n",
    "\n",
    "def render_filtered_table(d, limit=200):\n",
    "    cols = [c for c in TABLE_COLS if c in d.columns]\n",
    "    out = d.loc[:, cols].copy()\n",
    "\n",
    "    # Rename to match requested header wording\n",
    "    out = out.rename(columns={\"Application Status\": \"Status\"})\n",
    "\n",
    "    # Sort by Event Time if parsed column exists\n",
    "    if \"Event Time Parsed\" in d.columns:\n",
    "        out = out.assign(_sort=d[\"Event Time Parsed\"]).sort_values(\"_sort\").drop(columns=[\"_sort\"])\n",
    "\n",
    "    display(out.head(limit))\n",
    "\n",
    "def sanitize_dataframe(dataframe):\n",
    "    \"\"\"Replaces sensitive network attributes with generalized markers if toggle is selected.\"\"\"\n",
    "    d = dataframe.copy()\n",
    "    ip_cols = [\"Client IP\", \"Client External IP\", \"Server IP\"]\n",
    "    for col in ip_cols:\n",
    "        if col in d.columns:\n",
    "            d[col] = d[col].astype(str).str.replace(r\"\\d+\\.\\d+\\.\\d+\\.\\d+\", \"[MASKED_IP]\", regex=True)\n",
    "    if \"User\" in d.columns:\n",
    "        d[\"User\"] = d[\"User\"].astype(str).apply(lambda x: \"[MASKED_USER]\" if pd.notna(x) and x != \"NaN\" else x)\n",
    "    return d\n",
    "\n",
    "def call_llm_rest_api(provider, api_key, system_prompt, log_payload):\n",
    "    \"\"\"Handles unified API execution natively via the standard requests package to minimize dependencies.\"\"\"\n",
    "    if not api_key.strip():\n",
    "        return \"Error: API Key is missing. Please enter your secret key before submitting mapping requests.\"\n",
    "\n",
    "    try:\n",
    "        if \"Google AI Studio\" in provider:\n",
    "            url = f\"https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-pro:generateContent?key={api_key}\"\n",
    "            headers = {\"Content-Type\": \"application/json\"}\n",
    "            payload = {\n",
    "                \"contents\": [{\n",
    "                    \"parts\": [{\"text\": f\"System Rules: {system_prompt}\\n\\nAnalyze These Web Proxy logs:\\n{log_payload}\"}]\n",
    "                }]\n",
    "            }\n",
    "            response = requests.post(url, headers=headers, json=payload, timeout=45)\n",
    "            response_json = response.json()\n",
    "            return response_json['contents'][0]['parts'][0]['text']\n",
    "            \n",
    "        elif \"OpenAI\" in provider:\n",
    "            url = \"https://api.openai.com/v1/chat/completions\"\n",
    "            headers = {\"Authorization\": f\"Bearer {api_key}\", \"Content-Type\": \"application/json\"}\n",
    "            payload = {\n",
    "                \"model\": \"gpt-4o\",\n",
    "                \"messages\": [\n",
    "                    {\"role\": \"system\", \"content\": system_prompt},\n",
    "                    {\"role\": \"user\", \"content\": log_payload}\n",
    "                ]\n",
    "            }\n",
    "            response = requests.post(url, headers=headers, json=payload, timeout=45)\n",
    "            return response.json()['choices'][0]['message']['content']\n",
    "            \n",
    "        elif \"Anthropic\" in provider:\n",
    "            url = \"https://api.anthropic.com/v1/messages\"\n",
    "            headers = {\n",
    "                \"x-api-key\": api_key,\n",
    "                \"anthropic-version\": \"2023-06-01\",\n",
    "                \"content-type\": \"application/json\"\n",
    "            }\n",
    "            payload = {\n",
    "                \"model\": \"claude-3-5-sonnet-20241022\",\n",
    "                \"system\": system_prompt,\n",
    "                \"messages\": [{\"role\": \"user\", \"content\": log_payload}],\n",
    "                \"max_tokens\": 4000\n",
    "            }\n",
    "            response = requests.post(url, headers=headers, json=payload, timeout=45)\n",
    "            return response.json()['content'][0]['text']\n",
    "            \n",
    "    except Exception as e:\n",
    "        return f\"An execution interface error occurred while connecting to the provider: {str(e)}\"\n",
    "\n",
    "def run_ai_threat_hunt(_):\n",
    "    with ai_output_area:\n",
    "        clear_output()\n",
    "        print(\"Gathering context and loading matching dataset subsets...\")\n",
    "        \n",
    "        # Retrieve filtered data slice\n",
    "        working_df = filtered_df()\n",
    "        if working_df.empty:\n",
    "            print(\"No current record contexts match filters. Adjust search scopes before targeting execution.\")\n",
    "            return\n",
    "            \n",
    "        # Enforce user row restrictions\n",
    "        data_slice = working_df.head(ai_row_limit.value).copy()\n",
    "        \n",
    "        # Apply Sanitization Toggle\n",
    "        if ai_sanitize_toggle.value:\n",
    "            print(\"Sanitizing logs (Masking PII/Network Components)... \")\n",
    "            data_slice = sanitize_dataframe(data_slice)\n("
    "        \n",
    "        # Format logs as structured text matrix\n",
    "        log_string_data = data_slice.to_csv(index=False)\n",
    "        \n",
    "        print(f\"Sending {len(data_slice)} log entries to {ai_provider_dropdown.value} API for processing...\")\n",
    "        \n",
    "        # Dispatch Payload\n",
    "        analysis_result = call_llm_rest_api(\n",
    "            provider=ai_provider_dropdown.value,\n",
    "            api_key=ai_key_input.value,\n",
    "            system_prompt=ai_prompt_text.value,\n",
    "            log_payload=log_string_data\n",
    "        )\n",
    "        \n",
    "        clear_output()\n",
    "        print(f\"### Threat Hunting Assessment - {ai_provider_dropdown.value} ###\\n\")\n",
    "        print(analysis_result)\n",
    "\n",
    "def render_all(*_):\n",
    "    d = filtered_df()\n",
    "\n",
    "    with status_out:\n",
    "        clear_output()\n",
    "        print(f\"Filtered rows: {len(d):,} / {len(df):,}\")\n",
    "\n",
    "    with pivot_output:\n",
    "        clear_output()\n",
    "        out = pivot_count_df(d, pivot_dropdown.value).head(top_n_slider.value)\n",
    "        display(out)\n",
    "\n",
    "    with tail_output:\n",
    "        clear_output()\n",
    "        if \"Hostname\" in d.columns:\n",
    "            freq = (\n",
    "                d[\"Hostname\"]\n",
    "                .astype(\"string\").fillna(\"NaN\")\n",
    "                .value_counts()\n",
    "                .rename_axis(\"Hostname\")\n",
    "                .reset_index(name=\"Count\")\n",
    "            )\n",
    "            tail = freq.tail(30)\n",
    "            fig = px.bar(\n",
    "                tail,\n",
    "                y=\"Hostname\",\n",
    "                x=\"Count\",\n",
    "                orientation=\"h\",\n",
    "                title=\"Long Tail Domains (Least Frequent) — Filtered View\"\n",
    "            )\n",
    "            fig.show()\n",
    "        else:\n",
    "            print(\"No Hostname column found.\")\n",
    "\n",
    "    with table_output:\n",
    "        clear_output()\n",
    "        render_filtered_table(d, limit=200)\n",
    "\n",
    "def do_reset(_):\n",
    "    start_picker.value = None\n",
    "    end_picker.value = None\n",
    "    search_box.value = \"\"\n",
    "    search_cols.value = (\"Hostname\", \"URL\")\n",
    "    render_all()\n",
    "\n",
    "# ---------- Wire events ----------\n",
    "apply_btn.on_click(lambda _: render_all())\n",
    "reset_btn.on_click(do_reset)\n",
    "ai_analyze_btn.on_click(run_ai_threat_hunt)\n",
    "\n",
    "pivot_dropdown.observe(render_all, names=\"value\")\n",
    "top_n_slider.observe(render_all, names=\"value\")\n",
    "start_picker.observe(render_all, names=\"value\")\n",
    "end_picker.observe(render_all, names=\"value\")\n",
    "search_box.observe(render_all, names=\"value\")\n",
    "search_cols.observe(render_all, names=\"value\")\n",
    "\n",
    "# ---------- Layout ----------\n",
    "ui = widgets.VBox([\n",
    "    widgets.HTML(\"<h2>ZIA Threat Hunting Workbench</h2>\"),\n",
    "\n",
    "    widgets.HTML(\"<b>Pivot Explorer (filtered)</b>\"),\n",
    "    widgets.HBox([pivot_dropdown, top_n_slider]),\n",
    "    status_out,\n",
    "    pivot_output,\n",
    "\n",
    "    widgets.HTML(\"<b>Time Filters (Logged Time Parsed, LA)</b>\"),\n",
    "    widgets.HBox([start_picker, end_picker]),\n",
    "\n",
    "    widgets.HTML(\"<b>Search</b>\"),\n",
    "    search_box,\n",
    "    search_cols,\n",
    "    widgets.HBox([apply_btn, reset_btn]),\n",
    "\n",
    "    tail_output,\n",
    "\n",
    "    widgets.HTML(\"<b>Filtered Transactions (table view)</b>\"),\n",
    "    table_output,\n",
    "    \n",
    "    widgets.HTML(\"<hr style='border-top: 3px double #333;'><h2>⚡ AI Threat Hunting Co-Pilot</h2>\"),\n",
    "    widgets.HTML(\"<b>Step 1: Configure endpoint parameters & authorization</b>\"),\n",
    "    widgets.HBox([ai_provider_dropdown, ai_key_input]),\n",
    "    widgets.HTML(\"<b>Step 2: Customize behavioral analysis focus instructions</b>\"),\n",
    "    ai_prompt_text,\n",
    "    widgets.HTML(\"<b>Step 3: Execution scaling & compliance masking controls</b>\"),\n",
    "    widgets.HBox([ai_sanitize_toggle, ai_row_limit]),\n",
    "    widgets.HTML(\"<br>\"),\n",
    "    ai_analyze_btn,\n",
    "    widgets.HTML(\"<h4>AI Analysis Engine Response:</h4>\"),\n",
    "    ai_output_area\n",
    "])\n",
    "\n",
    "display(ui)\n",
    "render_all()\n"
   ]
  }
 ],
