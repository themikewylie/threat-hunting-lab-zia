{
  "name": "Threat Hunting Workshop",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter",
        "mathematic.vscode-pdf",
        "mechatroner.rainbow-csv"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python3",
        "jupyter.jupyterServerType": "local"
      }
    }
  },
  "postCreateCommand": "python3 -m pip install -r requirements.txt && python3 -m ipykernel install --user --name python3 --display-name \"Python 3.12 (Workshop)\" --force",
  "postAttachCommand": {
    "fix-kernel": "python3 -m ipykernel install --user --name python3 --display-name \"Python 3.12 (Workshop)\" --force"
  }
}
